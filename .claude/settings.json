{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)",
      "Bash(git push origin refs/tags/:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push origin main:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "Bash(git tag -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit --no-gpg-sign:*)",
      "Bash(make release-tag:*)",
      "Bash(make release-push:*)",
      "Bash(make hotfix-start:*)",
      "Bash(make github-protect)",
      "Bash(bash scripts/release/tag.sh:*)",
      "Bash(bash scripts/release/hotfix.sh:*)",
      "Bash(bash scripts/ci/apply-branch-protection.sh --apply:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release edit:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -X DELETE:*)"
    ]
  }
}
