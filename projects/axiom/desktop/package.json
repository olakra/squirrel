{
  "name": "axiom-desktop",
  "productName": "Axiom",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Project Axiom. Runs the bundled web/ build offline on Windows, macOS and Linux.",
  "main": "main.js",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "bun test test",
    "prepare-web": "bun scripts/prepare-web.mjs",
    "dist:win": "bun run prepare-web && electron-builder --win --dir --publish never",
    "dist:linux": "bun run prepare-web && electron-builder --linux --dir --publish never",
    "dist:mac": "bun run prepare-web && electron-builder --mac --universal --dir --publish never"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.15.6"
  }
}
